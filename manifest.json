{
  "manifest_version": 3,
  "name": "Buscador por teclado",
  "version": "1.0",
  "description": "Pulsa Ctrl para activar elementos de la página según el texto escrito.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.jpg",
    "48": "icons/icon48.jpg",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["keydown.js"],
      "run_at": "document_idle"
    }
  ]
}